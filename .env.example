# =============================================================================
# HMH Labz Agent Platform — environment. Copy to .env and fill in. NO real values here.
# Every secret is read from the environment only; a hardcoded key fails review.
# =============================================================================

# --- Application -------------------------------------------------------------
# local | test | staging | production. "production" disables /docs and /openapi.json.
APP_ENV=local
APP_VERSION=0.1.0
# Set by CI at build time (docker build --build-arg GIT_SHA=...). Reported by GET /health.
GIT_SHA=unknown
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Edge (Caddy) --------------------------------------------------------------
# Apex domain. Caddy serves api.<BASE_DOMAIN> and *.<BASE_DOMAIN>.
BASE_DOMAIN=hmhagents.com
# ACME account email for Let's Encrypt.
ACME_EMAIL=ops@example.com
# Cloudflare API token with Zone:DNS:Edit on BASE_DOMAIN — required for the wildcard
# certificate (DNS-01 challenge). Scope it to the one zone.
CLOUDFLARE_API_TOKEN=
# Rate limit on /api/v1/auth/* per client IP.
AUTH_RATE_LIMIT_EVENTS=10
AUTH_RATE_LIMIT_WINDOW=1m

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=agents
# Superuser: used only by the container's first-boot init script. Never by the app.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
# Owner role: owns every table, runs Alembic migrations. Never used by api/worker code paths.
DB_OWNER_USER=agents_owner
DB_OWNER_PASSWORD=
# App role: what api/worker/scheduler connect as. Owns nothing; always subject to RLS.
DB_APP_USER=agents_app
DB_APP_PASSWORD=

# Compose builds these from the values above. Set them directly only when running outside
# compose (tests, local uvicorn). Scheme must be postgresql+asyncpg://
# DATABASE_URL=postgresql+asyncpg://agents_app:<pw>@localhost:5432/agents
# MIGRATIONS_DATABASE_URL=postgresql+asyncpg://agents_owner:<pw>@localhost:5432/agents
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# Server-side statement timeout, ms. Protects the box from a runaway query.
DB_STATEMENT_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_S=5

# --- Redis -----------------------------------------------------------------------
# Compose sets REDIS_URL=redis://redis:6379/0. Set it directly only outside compose.
# REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_S=2
ARQ_QUEUE_NAME=arq:queue
ARQ_SCHEDULER_QUEUE_NAME=arq:scheduler

# --- Encryption at rest ------------------------------------------------------------
# Fernet key for Meta access tokens (tenant_channels.access_token_encrypted). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored token unreadable. Back it up separately from the DB dump.
APP_ENCRYPTION_KEY=

# --- Dashboard auth — Phase 3 ------------------------------------------------------------
# HS256 signing key for dashboard access tokens, at least 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it logs every dashboard user out (refresh tokens survive; access tokens do not).
JWT_SECRET=
# JWT_ACCESS_TTL_S=900
# JWT_REFRESH_TTL_S=1209600
# LOGIN_MAX_FAILURES=10
# LOGIN_FAILURE_WINDOW_S=900

# --- Meta (WhatsApp Cloud API) — used from Phase 1 -------------------------------------
# App secret of the HMH Labz Meta App: verifies X-Hub-Signature-256 on every webhook.
META_APP_SECRET=
# The verify token entered in the Meta App's webhook config (GET hub.challenge handshake).
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com
# Graph API timeouts (seconds) and retry budget for 429/5xx. Sends are never retried after a
# read timeout (the message may already have been delivered).
META_HTTP_TIMEOUT_S=10
META_CONNECT_TIMEOUT_S=5
META_MAX_RETRIES=3
# Largest inbound media (voice notes, images) the worker will download.
META_MEDIA_MAX_BYTES=26214400

# --- Webhook ingest ------------------------------------------------------------------------
# phone_number_id → tenant cache (01 §6.1: 5 min). Unknown ids are cached for the shorter TTL.
WEBHOOK_ROUTE_CACHE_TTL_S=300
WEBHOOK_ROUTE_NEGATIVE_TTL_S=60
# wamid dedup window (01 §6.1: 48 h).
WEBHOOK_DEDUP_TTL_S=172800

# --- Seeding (api/scripts/seed_tenant.py only; unset after use) -----------------------------
# Never pass these on the command line — argv is visible to every user via `ps`.
# SEED_META_ACCESS_TOKEN=   system-user token for the channel; stored Fernet-encrypted
# SEED_ADMIN_PASSWORD=      initial tenant admin password, min 12 chars

# --- LLM providers (01 §7) -----------------------------------------------------------------
# Gemini is primary (OpenAI-compatible endpoint); OpenRouter is the failover. Set a spend cap at
# each provider as well. A provider with no key is skipped.
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_NATIVE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# gemini-3-flash on Gemini ⇄ google/gemini-3-flash on OpenRouter
OPENROUTER_MODEL_PREFIX=google/
LLM_TIMEOUT_S=20
LLM_CONNECT_TIMEOUT_S=5
# USD per 1M tokens [input, output] per model, for llm_cost_usd in usage_daily. A model missing
# here is metered at 0 and logged as llm_price_unknown. Fill in gemini-3-flash from the price list.
LLM_PRICES_USD_PER_MTOK={"gemini-2.5-flash-lite": ["0.10", "0.40"]}
# Voice notes (OGG/Opus) are transcribed with Gemini's native audio input.
TRANSCRIPTION_MODEL=gemini-2.5-flash
# Rolling summaries; empty = the tenant's classify model.
SUMMARY_MODEL=

# Per-tenant chat/classify models live in tenant_settings (an UPDATE moves a tenant, not a deploy).

# --- Embeddings (fastembed, in-process) ------------------------------------------------------
# Spec default is English-only; on Arabic queries it cannot rank (measured). Recommended:
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  (also 384 dims)
# Changing it requires re-embedding knowledge_chunks and rebuilding the image (build arg).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=   set by the image (/opt/models); only set it when running outside Docker

# --- Agent turn -------------------------------------------------------------------------------
# Wait this long before answering, so messages sent seconds apart get ONE reply (scenario 18).
TURN_DEBOUNCE_S=2
CONVERSATION_LOCK_TTL_S=120
SUPPORT_MAX_TOOL_ROUNDS=5
# 01 §7.1 hard cap; the knowledge block is trimmed to fit.
SYSTEM_PROMPT_TOKEN_CAP=1500
SUMMARY_EVERY_N_INBOUND=6
# Both LLM providers down: retry the turn after N x attempt seconds (holding message sent once).
LLM_DOWN_RETRY_DEFER_S=60
